---
import { getEntry } from "astro:content";
import "../styles/tokens.css";
import "../styles/site.css";
interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  articleDate?: Date;
}
const { title, description, image, imageAlt, articleDate } = Astro.props;
const entry = await getEntry("pages", "home");
if (!entry) throw new Error("Site content is missing");
const content = entry.data;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const preview =
  import.meta.env.CONTEXT === "deploy-preview" || import.meta.env.CONTEXT === "branch-deploy";
const imageOrigin = preview
  ? process.env.DEPLOY_PRIME_URL || process.env.DEPLOY_URL || Astro.site
  : Astro.site;
const socialImage = new URL(image, imageOrigin).href;
const structured = articleDate
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      url: canonical,
      image: socialImage,
      datePublished: articleDate.toISOString(),
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: content.brand,
      url: canonical,
      description,
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f2e9" />
    <meta name="robots" content={preview ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/familjen-grotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/ibm-plex-sans.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:site_name" content={content.brand} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header container">
      <a class="wordmark" href="/" aria-label="Code Unpacked home">
        <img src="/logo-mark.svg" width="44" height="44" alt="" />
        <span>{content.brand}</span>
      </a>
      <nav aria-label="Main navigation">
        {content.navigation.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <a class="button header-install" href="/#install">
        Install the skills
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <a class="wordmark" href="/">
          <img src="/logo-mark.svg" width="44" height="44" alt="" />
          <span>{content.brand}</span>
        </a>
        <p>{content.footer.description}</p>
        <nav aria-label="Footer">
          {content.footer.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
        <p class="footer-note">
          {content.footer.note}{" "}
          <a href={content.footer.credit.href}>{content.footer.credit.label}</a>.
        </p>
      </div>
    </footer>
    <script src="../scripts/homepage.ts"></script>
  </body>
</html>
