---
import type { SourceContent } from "../lib/homepage-schema";
interface Props {
  source: SourceContent;
  label?: string;
}
const { source, label } = Astro.props;
---

{label ? (
  <details class="source-disclosure">
    <summary>{label}</summary>
    <figure class="source-block">
      <figcaption>{source.file}</figcaption>
      <pre><code>{source.code.trimEnd()}</code></pre>
    </figure>
  </details>
) : (
  <figure class="source-block">
    <figcaption>{source.file}</figcaption>
    <pre><code>{source.code.trimEnd()}</code></pre>
  </figure>
)}
