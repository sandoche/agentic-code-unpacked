---
import { getEntry, getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import Example from "../components/Example.astro";
import RunStats from "../components/RunStats.astro";
import CaseCard from "../components/CaseCard.astro";
import CommandBlock from "../components/CommandBlock.astro";
import { getRun, number } from "../lib/examples";
const entry = await getEntry("pages", "home");
if (!entry) throw new Error("Homepage content is missing");
const content = entry.data;
const cases = (await getCollection("caseStudies")).sort(
  (a, b) =>
    ["react", "vue", "silk"].indexOf(a.data.run) - ["react", "vue", "silk"].indexOf(b.data.run),
);
---

<SiteLayout {...content.seo}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-main">
      <div class="hero-copy">
        <h1 id="hero-title">{content.hero.title}</h1>
        <p>{content.hero.description}</p>
        <div class="actions">
          <a class="button primary" href={content.hero.primary.href}>
            {content.hero.primary.label}
          </a>
          <a class="text-link" href={content.hero.secondary.href}>
            {content.hero.secondary.label}
          </a>
        </div>
      </div>
      <figure class="monster-stage">
        <a class="monster-count" href={getRun("react").prUrl}>
          <strong>{number(getRun("react").stats.files)}</strong>
          <span>source files</span>
        </a>
        <img
          src="/images/pr-monsters.webp"
          width="1200"
          height="800"
          alt="Three paper monsters made from sprawling code diffs: an enormous coral beast, a teal creature, and a small yellow zip monster."
          fetchpriority="high"
        />
        <span class="hero-sticker" aria-hidden="true">
          {content.hero.note}
        </span>
        <figcaption>{content.hero.caption}</figcaption>
      </figure>
    </div>
    <div class="hero-runs">
      {["react", "vue", "silk"].map((id) => (
        <article class="hero-run">
          <h2>
            <a href={getRun(id).prUrl}>{getRun(id).name}</a>
          </h2>
          <RunStats run={id} />
        </article>
      ))}
    </div>
    <p class="snapshot-note">
      Pinned source snapshots. Vue and React statistics exclude the two showcase artifact commits;
      their PRs live in our forks.
    </p>
  </section>
  <div id="skills">
    {content.skills.map((skill, index) => (
      <section
        class={"skill-section skill-" + skill.id}
        id={skill.id}
        aria-labelledby={"title-" + skill.id}
      >
        <div class="container">
          <div class="skill-heading">
            <div>
              <p class="skill-label">
                <span>{String(index + 1).padStart(2, "0")}</span>
                {skill.name}
              </p>
              <h2 id={"title-" + skill.id}>{skill.title}</h2>
            </div>
            <div class="skill-description">
              <p>{skill.description}</p>
              <code>{skill.command}</code>
              <p class="instruction">{skill.instruction}</p>
            </div>
          </div>
          <Example id={skill.example} />
        </div>
      </section>
    ))}
  </div>
  <section class="section container" aria-labelledby="showcase-title">
    <div class="section-top">
      <div>
        <h2 class="section-title" id="showcase-title">
          {content.showcase.title}
        </h2>
        <p class="section-intro">{content.showcase.description}</p>
      </div>
      <a class="text-link" href={content.showcase.action.href}>
        {content.showcase.action.label}
      </a>
    </div>
    <div class="case-grid">
      {cases.map((entry) => (
        <CaseCard entry={entry} />
      ))}
    </div>
  </section>
  <section class="section install-section" id="install" aria-labelledby="install-title">
    <div class="container install-layout">
      <div>
        <h2 id="install-title">{content.install.title}</h2>
        <p class="lead">{content.install.description}</p>
      </div>
      <div>
        <CommandBlock command={content.install.command} ui={content.ui} />
        <p class="usage-label">Then bring a PR to your agent:</p>
        <CommandBlock command={content.install.usage} ui={content.ui} />
        <p class="usage-label">Using Codex?</p>
        <CommandBlock command={content.install.codexUsage} ui={content.ui} compact />
        <details class="install-details">
          <summary>Requirements and supported agents</summary>
          <p>{content.install.requirements}</p>
          <p>{content.install.agents.join(", ")}.</p>
          <a href={content.install.guide.href}>{content.install.guide.label}</a>
        </details>
      </div>
    </div>
  </section>
  <section class="section container faq-layout" id="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">{content.faq.title}</h2>
    <div class="faq-list">
      {content.faq.items.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</SiteLayout>
