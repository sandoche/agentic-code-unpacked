{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Unpacked context v1",
  "type": "object",
  "required": ["schemaVersion", "target", "source", "files", "evidence", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["pr", "branch", "codebase", "docs"] } } },
    "source": { "type": "object", "required": ["head"] },
    "files": { "type": "array", "items": { "type": "object", "required": ["id", "path", "status", "hunks"] } },
    "evidence": { "type": "array", "items": { "type": "object", "required": ["id", "fileId", "startLine", "endLine", "side"], "properties": { "startLine": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 }, "side": { "enum": ["head", "base"] } } } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "relationships": { "type": "array" }
  }
}
