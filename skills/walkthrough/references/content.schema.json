{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Unpacked walkthrough content",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "title", "steps"],
      "properties": {
        "schemaVersion": { "const": 1 }, "title": { "$ref": "#/$defs/text" }, "summary": { "type": "string" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "title", "chapters"],
      "properties": {
        "schemaVersion": { "const": 2 }, "title": { "$ref": "#/$defs/text" }, "summary": { "type": "string" },
        "overview": {
          "type": "object", "additionalProperties": false, "required": ["purpose", "evidence"],
          "properties": {
            "purpose": { "$ref": "#/$defs/text" }, "before": { "type": "string" }, "after": { "type": "string" },
            "evidence": { "$ref": "#/$defs/evidence" },
            "reviewOrder": { "type": "array", "items": { "$ref": "#/$defs/guidance" } },
            "extensionPoints": { "type": "array", "items": { "$ref": "#/$defs/guidance" } }
          }
        },
        "chapters": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "title", "steps"],
            "properties": {
              "id": { "$ref": "#/$defs/text" }, "title": { "$ref": "#/$defs/text" },
              "topicIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
              "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "guidance": {
      "type": "object", "additionalProperties": false, "required": ["title", "explanation", "evidence"],
      "properties": {
        "title": { "$ref": "#/$defs/text" }, "explanation": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/evidence" }, "basis": { "enum": ["proposed", "observed"] }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "explanation", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "title": { "$ref": "#/$defs/text" },
        "explanation": { "$ref": "#/$defs/text" }, "evidence": { "$ref": "#/$defs/evidence" },
        "codeEvidence": { "$ref": "#/$defs/text" }, "durationSeconds": { "type": "number", "minimum": 1, "maximum": 300 },
        "snippets": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["evidence"],
            "properties": {
              "evidence": { "$ref": "#/$defs/text" }, "label": { "type": "string" },
              "side": { "enum": ["before", "after", "context"] },
              "focusLines": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
            }
          }
        }
      }
    }
  }
}
