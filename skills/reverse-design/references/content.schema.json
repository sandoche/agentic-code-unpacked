{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Unpacked reverse-design content v2, with v1 compatibility",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "basis": {
      "enum": [
        "observed",
        "inferred",
        "proposed"
      ]
    },
    "claim": {
      "type": "object",
      "required": [
        "markdown",
        "basis",
        "evidence"
      ],
      "properties": {
        "markdown": {
          "$ref": "#/$defs/text"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "section": {
      "allOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "required": [
            "heading"
          ],
          "properties": {
            "heading": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "diagram": {
      "type": "object",
      "required": [
        "id",
        "title",
        "mermaid",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "question": {
          "$ref": "#/$defs/text"
        },
        "mermaid": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "flowId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "title",
        "family",
        "sections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "family": {
          "$ref": "#/$defs/id"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "diagrams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagram"
          }
        },
        "topicIds": {
          "$ref": "#/$defs/ids"
        },
        "flowIds": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "documentV1": {
      "allOf": [
        {
          "$ref": "#/$defs/document"
        },
        {
          "properties": {
            "sections": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "documentV2": {
      "allOf": [
        {
          "$ref": "#/$defs/document"
        },
        {
          "properties": {
            "diagrams": {
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/diagram"
                  },
                  {
                    "required": [
                      "question"
                    ]
                  }
                ]
              }
            }
          },
          "anyOf": [
            {
              "properties": {
                "sections": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "diagrams"
              ],
              "properties": {
                "diagrams": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      ]
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "status",
          "reason",
          "evidence"
        ],
        "properties": {
          "family": {
            "$ref": "#/$defs/id"
          },
          "status": {
            "enum": [
              "generated",
              "not-applicable",
              "insufficient-evidence"
            ]
          },
          "reason": {
            "$ref": "#/$defs/text"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "affectedDocuments",
          "evidence"
        ],
        "properties": {
          "question": {
            "$ref": "#/$defs/text"
          },
          "affectedDocuments": {
            "$ref": "#/$defs/ids"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "v1": {
      "type": "object",
      "required": [
        "schemaVersion",
        "title",
        "summary",
        "summaryEvidence",
        "documents"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "summaryEvidence": {
          "$ref": "#/$defs/evidence"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentV1"
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "gaps": {
          "$ref": "#/$defs/gaps"
        }
      }
    },
    "v2": {
      "type": "object",
      "required": [
        "schemaVersion",
        "title",
        "overview",
        "documents"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "overview": {
          "type": "object",
          "required": [
            "purpose",
            "reviewFocus",
            "extensionContext"
          ],
          "properties": {
            "purpose": {
              "$ref": "#/$defs/claim"
            },
            "reviewFocus": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/claim"
              }
            },
            "extensionContext": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentV2"
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "gaps": {
          "$ref": "#/$defs/gaps"
        }
      }
    }
  }
}
