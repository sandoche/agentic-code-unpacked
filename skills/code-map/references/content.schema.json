{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Map explanations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fileId", "title", "text", "evidenceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fileId": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fromFileId", "toFileId", "label", "evidenceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fromFileId": { "type": "string", "minLength": 1 },
          "toFileId": { "type": "string", "minLength": 1 },
          "fromSymbolId": { "type": "string", "minLength": 1 },
          "toSymbolId": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "provenance": { "type": ["string", "object"] },
          "label": { "type": "string", "minLength": 1 },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        }
      }
    }
  },
  "$defs": {
    "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
