{
  "name": "agentic-code-unpacked",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint:typescript && pnpm run skills:check && pnpm --filter website run check && pnpm run lint:skills && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint:typescript": "node scripts/lint-typescript.mjs",
    "skills:build": "node scripts/build-skills.mjs",
    "skills:check": "node scripts/build-skills.mjs --check",
    "lint:skills": "rumdl check skills",
    "test": "node scripts/test.mjs",
    "install:skills": "node scripts/install.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "lefthook": "^2.2.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "rumdl": "^0.3.2",
    "typescript": "7.0.2"
  }
}
